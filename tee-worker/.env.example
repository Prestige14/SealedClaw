# ============================================================
# SealedClaw TEE Worker — Environment Variables
# Copy this file to tee-worker/.env and fill in your values.
# The orchestrator (orchestrator.py) also injects most of these
# dynamically when spawning the TEE worker subprocess.
# ============================================================

# ── CONTRACT ADDRESSES (0G Galileo Testnet) ───────────────────
POLICY_VAULT_ADDRESS=0xCD4D495572A4b195ED393dE6E99aebfe181dce22
STRATEGY_VAULT_ADDRESS=0xcd43f5FE14BC64455A1a852eae7D277E687B16FD
AGENT_NFT_ADDRESS=0xd8572C039ea363FF52e30C022Fd5d99664f5c08d
TEE_REGISTRY_ADDRESS=0x04f514beaC867D5c6Dcc5aD346ec0a8a5E15c599
CHAINLINK_VERIFIER_ADDRESS=0xDcA9c41814d44A7F2d6dB014dBa0230E08313696
MARKETPLACE_ADDRESS=0x72Edd9218162a6bdc0AAa8365C9aF79fEfbF087e

# ── NETWORK ───────────────────────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602

# ── TEE IDENTITY ──────────────────────────────────────────────
TEE_IDENTITY=sealed-claw-tee-v1-mrenclave-abc123

# ── AGENT CONFIG ──────────────────────────────────────────────
# Injected dynamically by orchestrator.py at runtime.
# Set manually only when running tee-worker standalone.
TOKEN_ID=0
CURRENT_NONCE=0
TARGET_DEX_ADDRESS=0x1c6a39d272760EC39F05393432B9aBBb26264823

# ── AI / LLM ──────────────────────────────────────────────────
# Free Groq API key for Llama 3 inference (https://console.groq.com)
# Also injected by orchestrator.py — but required here for standalone runs.
# Optional — falls back to keyword matching if absent.
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── 0G STORAGE ────────────────────────────────────────────────
OG_STORAGE_NODE_URL=https://storage-testnet.0g.ai
OG_STORAGE_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ── ORACLE ────────────────────────────────────────────────────
# Chainlink Aggregator address for ETH/USD if needed directly
CHAINLINK_ETH_USD_FEED=
