# ============================================================
# SealedClaw TEE Worker — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.
# ============================================================

# ── TEE Identity ─────────────────────────────────────────────
# Simulates the MRENCLAVE value from the TEE attestation report.
# In production this is the SHA-256 measurement of the enclave binary.
# This value is used to derive the AES-256-GCM memory sealing key via HKDF.
TEE_IDENTITY=sealed-claw-tee-v1-mrenclave-abc123

# ── PolicyVault Contract ──────────────────────────────────────
# The deployed address of PolicyVault.sol on 0G Galileo Testnet.
# Used in compute_payload_hash() — MUST match the address(this) in Solidity.
POLICY_VAULT_ADDRESS=0xYourPolicyVaultAddressHere

# ── Token Configuration ───────────────────────────────────────
# The ERC-7857 token ID of the iNFT agent to operate.
# Must match the tokenId registered in PolicyVault.
TOKEN_ID=0

# The current on-chain nonce for TOKEN_ID from PolicyVault.nonces[tokenId].
# Fetch this before each run: PolicyVault.nonces(TOKEN_ID)
# CRITICAL: If this nonce is stale, ecrecover will return the wrong signer.
CURRENT_NONCE=0

# ── DEX Configuration ─────────────────────────────────────────
# Address of the DEX router to route trades through.
# Leave empty to use the built-in mock address (for testing only).
TARGET_DEX_ADDRESS=0xMockDEXAddressHere

# ── Notes for production deployment ──────────────────────────
# - TEE_IDENTITY should be fetched from the 0G Compute attestation API
#   and updated on each enclave restart.
# - POLICY_VAULT_ADDRESS should be the same contract address used during
#   deployment (from scripts/deploy.ts output).
# - CURRENT_NONCE must be fetched fresh from the chain before each cycle
#   to prevent signature replay attacks.
